con star" style="display: block; width: 18px; height: 18px;"><use href="#looxicons-rating-icon"></use></svg><svg viewBox="0 0 24 24" data-lx-fill="empty" role="presentation" aria-hidden="true" class="loox-icon star" style="display: block; width: 18px; height: 18px;"><use href="#looxicons-rating-icon"></use></svg><svg viewBox="0 0 24 24" data-lx-fill="empty" role="presentation" aria-hidden="true" class="loox-icon star" style="display: block; width: 18px; height: 18px;"><use href="#looxicons-rating-icon"></use></svg><svg viewBox="0 0 24 24" data-lx-fill="empty" role="presentation" aria-hidden="true" class="loox-icon star" style="display: block; width: 18px; height: 18px;"><use href="#looxicons-rating-icon"></use></svg></span></div></td><td style="padding:6px 10px;width:100%;" aria-hidden="true"><div class="loox-progress"><div style="width:0.1614018907078626%" class="loox-progress-value"></div></div></td><td style="padding-right: 4px" aria-hidden="true" class="reviews-num">(14)</td></tr></table></div><script>function onRatingRowKeyDown(event, stars) {
	if(loadMoreInProgress) return;

	if (event.key === 'Enter') onRatingClick(stars);
}

function onRatingClick(stars) {
	if(loadMoreInProgress) return;

	const currentSelectedRow = document.querySelector('.rating-filter-selected');
	const selectedRow = document.querySelector(`.rating-dist-row[data-rating="${stars}"]`);

	window.parent.postMessage(JSON.stringify({
			type: 'set-ref-interaction',
			ref: 'loox-widget-header-rating-filter',
			frame: frameId
	}), "*");



	const [loadMoreButton] = document.getElementsByClassName('#loadMore');

	if (loadMoreButton) {
		const url = new URL(loadMoreButton.dataset.url);

		if (selectedRow && currentSelectedRow !== selectedRow) {
			url.searchParams.set('rating', stars);

		} else {
			url.searchParams.delete('rating');
		}

		loadMoreButton.dataset.url = url.toString();
	}

	if (currentSelectedRow) currentSelectedRow.classList.remove('rating-filter-selected');
	if (selectedRow && currentSelectedRow !== selectedRow) selectedRow.classList.add('rating-filter-selected');

	if (currentSelectedRow) {
		currentSelectedRow.ariaPressed = false;
	}

	if (selectedRow && currentSelectedRow !== selectedRow) {
		selectedRow.ariaPressed = true;
	}

	// Update progress-section aria-label with active filter
	const progressSection = document.querySelector('.progress-section');
	if (progressSection) {
		if (selectedRow && currentSelectedRow !== selectedRow) {
			progressSection.setAttribute('aria-label', `Rating distribution - filtering by ${stars} stars`);
		} else {
			progressSection.setAttribute('aria-label', 'Rating distribution - filter reviews by star rating');
		}
	}

	window.dispatchEvent(new Event('blur'));
	window.loadMore(event, selectedRow)
}</script></div></div><style>#menu-icon-svg {
