	}

	exports.loadMore = function(e, el) {
		if (loadMoreInProgress) return;
		loadMoreInProgress = true;

		var self = document.querySelector('#loadMore');
		var next = self?.dataset.url;
		var eventTargetId = el.id;
		var { sort: sorting, rating, tab, topics } = el.dataset;
		const isSample = false;
		const isLivePreview = false;

		if (sorting) currentFilter.sorting = sorting;
		if (topics !== undefined) currentFilter.topics = topics || null;

		if (rating) {
			const currentClickIsSelecting = el.classList.contains('rating-filter-selected')
			currentFilter.rating = currentClickIsSelecting && rating;
		}

		if (tab) {
			currentFilter = {};
			currentTab = tab;
		}

		var reset = (el.reset || e.reset) || (page++ % 10 === 0 && window.innerWidth > 600);

		if (eventTargetId === 'goTop' || sorting || rating || tab || topics !== undefined) {
			reset = true;
			page = 1;

			let allParams = new URLSearchParams();
			let locationSearchParams = new URLSearchParams(window.location.search);
			let baseUrlParams = new URLSearchParams("h=&total=8674&language=en");

			if (currentFilter.sorting) allParams.set('sort', currentFilter.sorting);
			if (currentFilter.rating) allParams.set('rating', currentFilter.rating);
			if (currentFilter.topics) allParams.set('topics', currentFilter.topics);
			if (isSample) allParams.set('sample', 'true');
			if (isLivePreview) allParams.set('isLivePreview', 'true');
			if (window.location.search.includes('shopify_editor_preview=true')) allParams.set('shopify_editor_preview', 'true');

			const total = (currentTab === 'store') ? "22108" : "8674";
			allParams.set('total', total);

			for (const [key, value] of baseUrlParams) {
				if (!allParams.has(key)) allParams.set(key, value);
			}

			for (const [key, value] of locationSearchParams) {
				if (!allParams.has(key)) allParams.set(key, value);
			}

			allParams.set('currentTab', currentTab);

			// Tells the server which control was used, so it can skip what this response won't use, and the
			// header's distribution, so a sort or rating click doesn't query it again.
			var changed = tab ? 'tab' : rating ? 'rating' : topics !== undefined ? 'topics' : sorting ? 'sort' : null;
			if (changed) allParams.set('changed', changed);
			var headerDist = document.querySelector('#header')?.dataset.dist;
			if (headerDist) allParams.set('dist', headerDist);

			next = `${allParams.toString()}`;

			const goTopElement = document.querySelector('#goTop');
			if (goTopElement) goTopElement.style.display = 'none';
		}

		// Settles once the topics have faded out, so their data is swapped only after that.
		let smartFiltersLeaving = Promise.resolve();

		if (reset) {
			const itemsToRemove = document.querySelectorAll('.grid-item-wrap')
			msnry.remove(itemsToRemove);

			// The store tab has no summary: it starts leaving on the click. (It comes back on the product tab once
			// the response is in, so it enters with the new reviews rather than over an emptied list.)
			if (tab === 'store' && document.querySelector('loox-reviews-summaries-widget')) {
				window.dispatchEvent(new CustomEvent('loox:summaries-hide'));
			}

			// A tab or rating change swaps the topics (counts differ, or the tab has none): they fade out
			// while the response is fetched. The rest of the bar, the sort button, stays.
			if ((tab || rating) && document.querySelector('loox-reviews-smart-filters-widget')) {
				window.dispatchEvent(new CustomEvent('loox:smart-filters-topics-leave'));
				smartFiltersLeaving = new Promise(resolve => setTimeout(resolve, 300));
			}

			if (!sorting && !rating && !tab && topics === undefined) {
				window.parent.postMessage(JSON.stringify({ type: 'scroll_to_view', frame: frameId }), "*");
			}
		}

		const { origin, pathname } = window.location;

		fetch(`${origin}${pathname}?${next}`)
			.then(response => response.text())
			.then(data => {
				const parser = new DOMParser();
				const html = parser.parseFromString(data, 'text/html');
				const items = html.querySelectorAll('.grid-item-wrap');
				const newSummariesWidget = html.querySelector('loox-reviews-summaries-widget');

				items.forEach(item => grid.appendChild(item));

				images(items);

				if (reset) msnry.prepended(items);
				else msnry.appended(items);

				msnry.layout();

				setTimeout(function () {
					const firstItem = items[0];
					if (firstItem) {
						const gridItem = firstItem.querySelector('.grid-item');

						const isFirstPageTabChange = tab && page === 1;

						if (gridItem) {
							const pageSummariesWidget = document.querySelector('loox-reviews-summaries-widget');
							if (isFirstPageTabChange && newSummariesWidget && pageSummariesWidget) {
								pageSummariesWidget.focus()
							} else {
								gridItem.focus();
							}
						}
					}
				}, 0);

				if (reset) document.dispatchEvent(new CustomEvent('iframe-resize'));

				const nextButton = html.querySelector('#loadMore');
				if (!nextButton) {
					if (self) self.style.display = 'none';
				} else {
					if (self) {
						if (!items.length) {
							self.style.display = 'none';
						} else {
							const dataUrl = nextButton.getAttribute('data-url');
							if(dataUrl) {
								self.style.display = '';
								self.setAttribute('data-url', dataUrl);
							} else {
								self.style.display = 'none';
							}
						}
					}
				}

				if (page > 10 && window.innerWidth > 600) {
					const goTopElement = document.querySelector('#goTop');
					if (goTopElement) goTopElement.style.display = '';
				}

				if (self) self.blur();

				if (tab) {
					const header = html.querySelector('#header');

					if (header) {


						if (tab === 'product') {
							productHeader = header;
						}

						if (tab === 'store') {
							storeHeader = header;
						}
					}

					const beTheFirstEl = document.querySelector('.bk-text');
					const newBeTheFirstEl = html.querySelector('.bk-text');
					if (beTheFirstEl) {
						beTheFirstEl.replaceWith(newBeTheFirstEl);
					}


					reRenderHeader();
				}

				// A topic or rating change re-renders the header: the server keeps the distribution free of the rating filter
				// (the count and average follow it), so only the pressed rating row is client state.
				if (!tab && (topics !== undefined || rating)) {
					const filteredHeader = html.querySelector('#header');

					if (filteredHeader) {
						const selectedStars = currentFilter.rating;
						const selectedRatingRow = selectedStars && filteredHeader.querySelector('.rating-dist-row[data-rating="' + selectedStars + '"]');
						if (selectedRatingRow) {
							selectedRatingRow.classList.add('rating-filter-selected');
							selectedRatingRow.ariaPressed = true;
							const progressSection = filteredHeader.querySelector('.progress-section');
							if (progressSection) progressSection.setAttribute('aria-label', 'Rating distribution - filtering by ' + selectedStars + ' stars');
						}

						if (currentTab === 'store') storeHeader = filteredHeader;
						else productHeader = filteredHeader;

						reRenderHeader();
					}
				}

				// The topics: on a tab or rating change their data is swapped once they have faded out. The widget
				// element stays, so the sort button and its state are untouched; the new topics fade in.
				if (tab || rating) {
					smartFiltersLeaving.then(() => {
						if (hasSmartFiltersDataChanged(html)) {
							// The data first: the widget reads it when it renders.
							replacePageScript(html, 'loox-reviews-smart-filters-data');
							currentSmartFiltersDataText = getPageScriptText(html, 'loox-reviews-smart-filters-data');
						}
						window.dispatchEvent(new CustomEvent('loox:smart-filters-topics-update'));
					});
				}

				// The summary follows the topic chips by itself (loox:topic-filter); a sort, rating or further page never
				// touches it. Here it comes back on the product tab, or is inserted when a response brings the first
				// summary to a page that had none.
				const summariesWidget = document.querySelector('loox-reviews-summaries-widget');
				if (summariesWidget && tab === 'product' && newSummariesWidget) {
					window.dispatchEvent(new CustomEvent('loox:summaries-show'));
				} else if (newSummariesWidget && !summariesWidget) {
					replacePageScript(html, 'loox-reviews-summaries-data');
					if (!isReviewsSummariesScriptLoaded) {
						replacePageScript(html, 'loox-reviews-summaries-script');
						isReviewsSummariesScriptLoaded = true;
					}
					newSummariesWidget.classList.add('entering');
					grid.parentNode.insertBefore(newSummariesWidget, grid);
					setTimeout(() => newSummariesWidget.classList.remove('entering'), 400);
				}

				if (typeof resetBadgesTooltip === "function") {
					resetBadgesTooltip()
				}
				loadMoreInProgress = false;
			});
	};
})(window);
</script><script>(function () {
	function getUrlParameter(name) {
		name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
		var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
		var results = regex.exec(location.search);

		return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
	}

	var iOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
	var event_name = iOS ? 'touchend' : 'click';

	var reportEngagement = window.LOOX.createReportEngagement({
		widgetType: 'product-reviews',
		productId: "",
	});

	if (iOS) document.addEventListener('touchstart', {});

	document.addEventListener(event_name, function (e) {
		const loadMoreElement = e.target.closest('#loadMore');

		if(loadMoreElement && loadMoreElement.classList.contains('preview-visible')) {
			return;
		}

		if (loadMoreElement) {
			reportEngagement('load_more_clicked');
			loadMore(e, loadMoreElement);
		}
	});

	document.addEventListener(event_name, function (e) {
		const dropdownButtonElement = e.target.closest('.loox-dropdown li button');
		if (dropdownButtonElement) {
			const { sort: sorting, rating, tab } = dropdownButtonElement.dataset;
			if (sorting) reportEngagement('sort_clicked', { sorting });
			if (rating) reportEngagement('rating_filter_clicked', { rating });
			if (tab) reportEngagement('tab_clicked', { tab });
			if (!sorting && !rating && !tab) reportEngagement('load_more_dropdown_clicked');
			loadMore(e, dropdownButtonElement);
		}
	});

	// Listen for sort changes from the smart filters widget
	window.addEventListener('loox:sort-change', function (e) {
		var sorting = e.detail && e.detail.sort;
		if (sorting) {
			reportEngagement('sort_clicked', { sorting });
			// Create a mock element with dataset.sort to pass to loadMore
			loadMore(e, { dataset: { sort: sorting } });
		}
	});

	// Smart filters analytics (loox_topic_chip_clicked, loox_topic_chip_cleared, loox_sort_button_clicked)
	['topic-chip-clicked', 'topic-chip-cleared', 'sort-button-clicked'].forEach(function (name) {
		window.addEventListener('loox:' + name, function (e) {
			reportEngagement(name.replace(/-/g, '_'), Object.assign({
				clientId: "PHBYpxGOVx",
				entityId: "",
			}, e.detail));
		});
	});

	// Listen for topic filter changes from the smart filters widget
	window.addEventListener('loox:topic-filter', function (e) {
		var topicId = e.detail && e.detail.topicId;
		// Pass topics (empty string to clear, or the topic ID)
		loadMore(e, { dataset: { topics: topicId || '' } });
	});

	document.addEventListener(event_name, function (e) {
		const goTopElement = e.target.closest('#goTop');
		if (goTopElement) {
			reportEngagement('go_top_clicked');
			loadMore(e, goTopElement);
		}
	});

	document.addEventListener(event_name, function (e) {
		const target = e.target.closest('#write, #bethefirst, .write-review-trigger');
		if (target) {
			const language = getUrlParameter('language');

			window.parent.postMessage(JSON.stringify({ type: "write", frame: frameId, language }), "*");
			reportEngagement('write_review_clicked');
		}
	});

	function openQuickview(postId, showOriginal = false) {
		const language = getUrlParameter('language');

		window.parent.postMessage(JSON.stringify({
				type: "quickview",
				postId,
				frame: frameId,
				ref: "inline",
				language,
				thumbnails: "true",
				showOriginal,
				markHighlight: true
			}), "*");
	}

	function openStoreQuickview(storeReviewId, showOriginal = false) {
		const language = getUrlParameter('language');

		window.parent.postMessage(JSON.stringify({
			type: "store-review-quickview",
			storeReviewId,
			frame: frameId,
			ref: "inline",
			language,
			showOriginal
		}), "*");
	}

	function onProductThumbnailContainerClick(el) {
		const postId = el ? el.getAttribute('data-product-review-id') : null;
		if (postId) {
			const showOriginal = el ? el.getAttribute('data-show-original') : null;
			reportEngagement('review_clicked', { postId });
			openQuickview(postId, showOriginal === 'true');
		}
	}

	function getActiveTab() {
		const tabs = document.querySelector('.tabs');

		if (tabs) {
			return tabs.getAttribute('data-active');
		}

		return "product"
	}

	function onPostItemClick(gridItem) {
		const id = gridItem.getAttribute('data-id');
		const selector = 'data-show-original';
		const dataShowOriginalEl = gridItem.querySelector(`[${selector}]`);
		const showOriginal = dataShowOriginalEl?.getAttribute(`${selector}`) === 'false';

		if (getActiveTab() === 'store') {
			reportEngagement('store_review_clicked', { postId: id });
			openStoreQuickview(id, showOriginal);
			return;
		}

		reportEngagement('review_clicked', {
			postId: id,
			mediaType: gridItem.getAttribute('data-media-type'),
			reviewSource: gridItem.getAttribute('data-review-source'),
		});
		openQuickview(id, showOriginal);
	}

	function reportClick(e) {
		const gridItem = e.target.closest('.grid-item');
		const postId = gridItem ? gridItem.getAttribute('data-id') : "";
		
		window.parent.postMessage(JSON.stringify({
			type: 'reportShowOriginalClick',
			frame: frameId,
			url: "https://fujin.loox.io/e",
			postId,
			data: [
			'cat=widget-event',
			'sub=product-reviews-widget',
			'el_cat=auto-translations-button',
			'a=click',
			's=show-original-button',
			'el=translated_reviews',
			"country=IN",
			"lang=",
			"d=nobero.com",
			"c=PHBYpxGOVx",
			"pid=",
			],
		}), "*");
	}

	function onShowOriginalClick(el, e) {
		if(false) return;

		const id = el.getAttribute('data-review-id');
		const showOriginal = el.getAttribute('data-show-original') === 'true';

		loadReviewItem(id, showOriginal);

		reportClick(e);
		reportEngagement('show_original_clicked', { postId: id });
		e.stopImmediatePropagation();
	}

	document.addEventListener('keydown', function (e) {
		const gridItem = e.target.closest('.grid-item-wrap');
		if (gridItem && (e.keyCode === 13 || e.keyCode === 32)) onPostItemClick(gridItem);
	});

	document.addEventListener('click', function (e) {
		const showOriginalCtaEl = e.target.closest('.show-original-cta');
		if (showOriginalCtaEl) {
			onShowOriginalClick(showOriginalCtaEl, e);
			return;
		}

		const productThumbnailContainerEl = e.target.closest('.product-thumbnail-container');
		if (productThumbnailContainerEl && getActiveTab() !== 'store') {
			onProductThumbnailContainerClick(productThumbnailContainerEl);
			return;
		}

		const gridItem = e.target.closest('.grid-item-wrap');
		if (gridItem) {
			onPostItemClick(gridItem);
			return;
		}
	});
})();
</script><script>var frameId = "looxReviewsFrame";
(function () {
	var loaded = false;

	document.addEventListener('iframe-has-height', function () {
		var widgetFont = "Roboto";

		var init = function () {
			loaded = true;
			document.dispatchEvent(new CustomEvent('font-loaded'));
			document.body.className = "grid-active";
			document.querySelector('html').setAttribute('lang', "en")
			// Widget visible KPI: the document was hidden until this line (`body { visibility:
			// hidden }`), so this is the first moment a shopper sees anything. Deliberately not
			// gated on the parent resizing the iframe: that height arrives on a 100ms poll, which
			// would quantise the measurement more coarsely than the thing being measured.
			//
			// Gated on `empty` so this milestone covers the same widgets the ready milestone does.
			if (true) {
				window.parent.postMessage(JSON.stringify({ type: 'loox:widget_visible', payload: { widgetType: 'product-reviews', tags: ['widget_version:v1', 'layout:grid', "surface:inline", "review_count:20"] } }), '*');
			}
		};

		var delayedInit = function() {
			setTimeout(function() {
				init();
			}, 0);
		}

		if (typeof Promise === "function") {
			if(document.fonts && document.fonts.ready) {
				return document.fonts.ready.then(delayedInit, delayedInit);
			}
			
			return new FontFaceObserver(widgetFont).load().then(delayedInit, delayedInit);
		}
		

		setTimeout(function () {
			if (!loaded) init();
		}, 1000);
	});

	document.addEventListener('iframe-resize', function () {
		var height = document.getElementsByTagName('html')[0].offsetHeight;
		window.parent.postMessage(JSON.stringify({ type: 'resize', height, frame: frameId }), "*");
	});

	document.onreadystatechange = function () {
		if (document.readyState !== 'complete') return;
		var h = 0;
		var has_height = false;

		setInterval(function () {
			var { offsetHeight } = document.getElementsByTagName('html')[0];

			if (offsetHeight > 0 && !has_height) {
				has_height = true;
				document.dispatchEvent(new CustomEvent('iframe-has-height'));
			}

			if ((h < offsetHeight || Math.abs(offsetHeight - h) >= 50) && !LOOX.inHcpModalMode) {
				h = offsetHeight;
				window.parent.postMessage(JSON.stringify({ type: 'resize', height: h, frame: frameId }), "*");
			}
		}, 100);
	};
})();
</script><script>(function() {
    var dist_open = null;
    var current_tab = document.querySelector('.tabs')?.getAttribute('data-active');

    function handleChevron() {
        const headerChevron = document.querySelector('.header-chevron');
        if (headerChevron) {
            Array.from(headerChevron.children).forEach(child => {
                if (child.classList.contains('chevron-hide')) child.classList.remove('chevron-hide');
                else child.classList.add('chevron-hide');
            });
        }
    }

    function openDist() {
        const headerChevron = document.querySelector('.header-chevron');
        window.focus();

        const reviewsDist = document.querySelector('.reviews-dist');
        if (reviewsDist) reviewsDist.style.display = 'block';

        if (headerChevron) headerChevron.classList.add('dialog-open');

        const summaryContent = document.querySelector('.summary-content.b');
        if (summaryContent) summaryContent.ariaExpanded = "true";

        dist_open = true;
        handleChevron();

        window.parent.postMessage(JSON.stringify({
            type: 'set-ref-interaction',
            ref: 'loox-header-dist',
            frame: frameId
        }), "*");
    }

    function closeDist() {
        const headerChevron = document.querySelector('.header-chevron');
        if (distributionDropdown) distributionDropdown.classList.add('close-dialog-animation');

        dist_open = null;

        const summaryContent = document.querySelector('.summary-content.b');
        if (summaryContent) summaryContent.ariaExpanded = "true";

        if (headerChevron) {
            headerChevron.classList.remove('dialog-open');
            headerChevron.blur();
        }

        handleChevron();
    }

    addAnimationendEventListener();

    function closeDistributionOnClickOutside(e) {
        if (window.innerWidth <= 480 || !dist_open) {
            return;
        }

        const parentElementWithPanelDist = e.target.closest('[data-panel="dist"]');

        if (!parentElementWithPanelDist) { 
            closeDist();
        }
    }

    function closeDistributionDialogOnEscButton(e) {
        if (e.keyCode != 27) return;

        if (dist_open)
            closeDist();
    };

    function addAnimationendEventListener() {
        distributionDropdown = document.getElementsByClassName('reviews-dist')[0];
        if (distributionDropdown) {
            distributionDropdown.addEventListener('animationend', function () {
                if (distributionDropdown.classList.contains('close-dialog-animation')) {
                    distributionDropdown.classList.remove('close-dialog-animation');

                    const reviewsDist = document.querySelector('.reviews-dist');
                    if (reviewsDist) reviewsDist.style.display = 'none';
                }
            })
        }
    }

    window.addEventListener('click', closeDistributionOnClickOutside);
    window.addEventListener('keyup', closeDistributionDialogOnEscButton);

    document.addEventListener('click', function (e) {
        addAnimationendEventListener();

        const tabEl = e.target.closest('.tabs__tab');
        if(tabEl) {
            const dataTab = tabEl.getAttribute('data-tab');
            if(dataTab !== current_tab) {
                dist_open = null;
                current_tab = dataTab;
            }

            return;
        }
        

        const summaryContent = e.target.closest('.summary-content.b');

        if(!summaryContent || !distributionDropdown) return;

        if(!dist_open) distributionDropdown.classList.remove('close-dialog-animation');

        if(!dist_open) openDist();
        else closeDist();
    });

    document.querySelector('.loox-dropdown.reviews-dist')?.addEventListener('click', function (e) {
        e.stopPropagation();
    });

    window.addEventListener('blur', function () {
        if (window.innerWidth > 480 && dist_open) closeDist();
    })
})()</script><script>(function() {
    var menu_open = null

    function openDropDown() {
        window.focus();
        menu_open = true;
        const dropdown = document.querySelector('ul.loox-dropdown');
        if (dropdown) dropdown.style.display = 'block';
        window.parent.postMessage(JSON.stringify({
            type: 'set-ref-interaction',
            ref: 'loox-header-menu',
            frame: frameId
        }), "*");
    }

    function closeDropDown() {
        const menuIcon = document.querySelector('.menu-icon');
        if (menuIcon) menuIcon.blur();

        const dropdown = document.querySelector('ul.loox-dropdown');
        if (dropdown) dropdown.style.display = 'none';

        menu_open = null;
    }

    document.addEventListener('click', function (e) {
        const looxDropdownItem = e.target.closest('.loox-dropdown li:has(button)');
        if (looxDropdownItem) {
            document.querySelectorAll('.chosen-option').forEach(option => {
                option.classList.remove('chosen-option');

                const wrapper = option.closest('button');
                if (wrapper) {
                    wrapper.ariaPressed = "false";
                }
            });

            const button = looxDropdownItem.querySelector('button')
            if (button) button.ariaPressed = "true";

            const span = looxDropdownItem.querySelector('span');
            if (span) span.classList.add('chosen-option');

            closeDropDown();

            return;
        }

        const menuIcon = e.target.closest('.menu-icon');
        if (!menuIcon) return;

        if (!menu_open) openDropDown();
        else closeDropDown();
    });

    function closeDialogOnClickOutside(e) {
        if (e.target.dataset.panel != "dropdown" && menu_open) closeDropDown();
    }

    function closeDialogOnEscButton(e) {
        if (e.keyCode != 27) return;
        if (menu_open) closeDropDown();
    };

    window.addEventListener('click', closeDialogOnClickOutside);
    window.addEventListener('keyup', closeDialogOnEscButton);
    window.addEventListener('blur', closeDropDown);
})()</script></body></html>