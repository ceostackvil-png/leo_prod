	function findAndObserveHighlightedElements(){
		if (false) {
			return;
		}

		var grid = document.getElementById('grid');
		if (!grid) return;

		var elements = grid.querySelectorAll(".highlighted-text");
		elements.forEach(function(el) {
			if (el.dataset.animated !== "true") {
				window.observeHighlightedTextElement(el);
			}
		});
