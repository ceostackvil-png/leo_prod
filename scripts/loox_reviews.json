		const selector = currentTab === 'product' ? '.item-img img' : '.product-thumbnail-container img';
		const imgs = Array.from(items).flatMap(item => Array.from(item.querySelectorAll(selector)));

		const firstImgEl = imgs?.[0];
		if(firstImgEl) {
			const width = firstImgEl.getBoundingClientRect(firstImgEl).width;
			const style = window.getComputedStyle(firstImgEl);
			const marginLeft = parseFloat(style.marginLeft);
			const marginRight = parseFloat(style.marginRight);
			outerWidth = width + marginLeft + marginRight;
