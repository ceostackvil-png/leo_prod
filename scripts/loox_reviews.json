	function observeHighlightedTextElement(el) {
		if (!('IntersectionObserver' in window)) {
			return;
		}

		if (!highlightsIntersectionObserver) {
			highlightsIntersectionObserver = new IntersectionObserver(function(entries, obs){
				entries.forEach(function(entry){
					if (entry.isIntersecting) {
						entry.target.classList.remove('invisible-marker')
						entry.target.classList.add('is-animated'); 
						entry.target.dataset.animated = "true";
						obs.unobserve(entry.target);               
