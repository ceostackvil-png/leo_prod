# ==============================================================================
# LEO — Men's Streetwear & Fashion Ecommerce Platform
# Example Environment Configuration (.env.example)
# Copy this file to .env and update values for your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server / Backend Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:3000
DB_FILE_PATH=./server/data/db.json

# ------------------------------------------------------------------------------
# 2. Frontend / Vite Client Configuration
# ------------------------------------------------------------------------------
VITE_APP_NAME="LEO — The King Men's Wear"
VITE_API_BASE_URL=/api
VITE_BACKEND_PROXY_TARGET=http://localhost:5001
VITE_CURRENCY=INR
VITE_CURRENCY_SYMBOL=₹
VITE_FREE_SHIPPING_THRESHOLD=999

# ------------------------------------------------------------------------------
# 3. Payment & Logistics Keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
DELHIVERY_API_TOKEN=your_delhivery_api_token
DEFAULT_CARRIER="Delhivery Express"

# ------------------------------------------------------------------------------
# 4. Admin Portal & Security
# ------------------------------------------------------------------------------
ADMIN_PORTAL_ROUTE=/admin
ADMIN_DEFAULT_EMAIL=admin@leomenswear.com
JWT_SECRET=replace_with_a_strong_secret_key

